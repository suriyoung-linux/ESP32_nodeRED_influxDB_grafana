    {
        "id": "node_mqtt_in_telemetry",
        "type": "mqtt in",
        "z": "tab_esp32",
        "name": "Telemetry",
        "topic": "ESP32-Level3/telemetry",
        "qos": "0",
        "datatype": "json",
        "broker": "0ac163c9e74fa511",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 90,
        "y": 220,
        "wires": [
            [
                "node_parse_telemetry",
                "node_debug_telemetry"
            ]
        ]
    },
    {
        "id": "node_parse_telemetry",
        "type": "function",
        "z": "tab_esp32",
        "name": "Parse Telemetry",
        "func": "var data = msg.payload;\n\n// DS18B20\nflow.set('ds18_temp', data.ds18 ? data.ds18.temp : null);\nflow.set('ds18_sim',  data.ds18 ? data.ds18.sim  : null);\n\n// XY-MD03\nflow.set('xymd_temp', data.xymd ? data.xymd.temp : null);\nflow.set('xymd_hum',  data.xymd ? data.xymd.hum  : null);\n\n// Weather\nflow.set('weather', data.weather || {});\n\n// System\nflow.set('sys', data.sys || {});\n\n// Relay status\nif (data.relay) {\n    flow.set('relay1', data.relay['1']);\n    flow.set('relay2', data.relay['2']);\n    flow.set('relay3', data.relay['3']);\n}\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 310,
        "y": 400,
        "wires": [
            [
                "node_split_telemetry"
            ]
        ]
    },
    {
        "id": "node_split_telemetry",
        "type": "function",
        "z": "tab_esp32",
        "name": "Split to Outputs",
        "func": "var d = msg.payload;\n\nvar ds18_temp  = { payload: d.ds18  ? d.ds18.temp  : '--' };\nvar xymd_temp  = { payload: d.xymd  ? d.xymd.temp  : '--' };\nvar xymd_hum   = { payload: d.xymd  ? d.xymd.hum   : '--' };\nvar w_temp     = { payload: d.weather ? d.weather.temp  : '--' };\nvar w_hum      = { payload: d.weather ? d.weather.hum   : '--' };\nvar w_rain     = { payload: d.weather ? d.weather.rain  : '--' };\nvar w_pm25     = { payload: d.weather ? d.weather.pm25  : '--' };\nvar w_aqi_lbl  = { payload: d.weather ? (d.weather.aqi + ' - ' + d.weather.aqiLabel) : '--' };\nvar sys_ip     = { payload: d.sys ? d.sys.ip     : '--' };\nvar sys_rssi   = { payload: d.sys ? d.sys.rssi   : '--' };\nvar sys_heap   = { payload: d.sys ? Math.round(d.sys.heap/1024) + ' KB' : '--' };\nvar sys_uptime = { payload: d.sys ? d.sys.uptime + ' s' : '--' };\n\nvar relay1_val = { payload: d.relay ? (d.relay['1']==='ON' ? true : false) : false };\nvar relay2_val = { payload: d.relay ? (d.relay['2']==='ON' ? true : false) : false };\nvar relay3_val = { payload: d.relay ? (d.relay['3']==='ON' ? true : false) : false };\n\nreturn [ds18_temp, xymd_temp, xymd_hum, w_temp, w_hum, w_rain, w_pm25, w_aqi_lbl, sys_ip, sys_rssi, sys_heap, sys_uptime, relay1_val, relay2_val, relay3_val];",
        "outputs": 15,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 530,
        "y": 400,
        "wires": [
            [
                "ui_gauge_ds18"
            ],
            [
                "ui_gauge_xymd_temp"
            ],
            [
                "ui_gauge_xymd_hum"
            ],
            [
                "ui_text_w_temp"
            ],
            [
                "ui_text_w_hum"
            ],
            [
                "ui_text_w_rain"
            ],
            [
                "ui_text_w_pm25"
            ],
            [
                "ui_text_w_aqi"
            ],
            [
                "ui_text_sys_ip"
            ],
            [
                "ui_text_sys_rssi"
            ],
            [
                "ui_text_sys_heap"
            ],
            [
                "ui_text_sys_uptime"
            ],
            [
                "ui_switch_relay1"
            ],
            [
                "ui_switch_relay2"
            ],
            [
                "ui_switch_relay3"
            ]
        ]
    },
