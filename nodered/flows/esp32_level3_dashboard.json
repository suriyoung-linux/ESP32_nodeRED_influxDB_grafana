    {
        "id": "node_build_influx_points",
        "type": "function",
        "z": "tab_influx",
        "name": "Build InfluxDB Points",
        "func": "var d = msg.payload;\nvar fields = {};\n\nif (d.ds18) {\n    if (d.ds18.temp !== undefined && d.ds18.temp !== null) fields.ds18_temp = Number(d.ds18.temp);\n    if (d.ds18.sim  !== undefined && d.ds18.sim  !== null) fields.ds18_sim  = Number(d.ds18.sim);\n}\n\nif (d.xymd) {\n    if (d.xymd.temp !== undefined && d.xymd.temp !== null) fields.xymd_temp = Number(d.xymd.temp);\n    if (d.xymd.hum  !== undefined && d.xymd.hum  !== null) fields.xymd_hum  = Number(d.xymd.hum);\n}\n\nif (d.weather) {\n    if (d.weather.temp !== undefined && d.weather.temp !== null) fields.weather_temp = Number(d.weather.temp);\n    if (d.weather.hum  !== undefined && d.weather.hum  !== null) fields.weather_hum  = Number(d.weather.hum);\n    if (d.weather.rain !== undefined && d.weather.rain !== null) fields.weather_rain = Number(d.weather.rain);\n    if (d.weather.pm25 !== undefined && d.weather.pm25 !== null) fields.weather_pm25 = Number(d.weather.pm25);\n    if (d.weather.aqi  !== undefined && d.weather.aqi  !== null) fields.weather_aqi  = Number(d.weather.aqi);\n    if (d.weather.aqiLabel !== undefined && d.weather.aqiLabel !== null) fields.weather_aqiLabel = String(d.weather.aqiLabel);\n}\n\nif (d.sys) {\n    if (d.sys.rssi   !== undefined && d.sys.rssi   !== null) fields.sys_rssi   = Number(d.sys.rssi);\n    if (d.sys.heap   !== undefined && d.sys.heap   !== null) fields.sys_heap   = Number(d.sys.heap);\n    if (d.sys.uptime !== undefined && d.sys.uptime !== null) fields.sys_uptime = Number(d.sys.uptime);\n    if (d.sys.ip     !== undefined && d.sys.ip     !== null) fields.sys_ip     = String(d.sys.ip);\n}\n\nif (d.relay) {\n    if (d.relay['1'] !== undefined) fields.relay1 = (d.relay['1'] === 'ON') ? 1 : 0;\n    if (d.relay['2'] !== undefined) fields.relay2 = (d.relay['2'] === 'ON') ? 1 : 0;\n    if (d.relay['3'] !== undefined) fields.relay3 = (d.relay['3'] === 'ON') ? 1 : 0;\n}\n\nif (Object.keys(fields).length === 0) {\n    return null; // ไม่มีข้อมูลให้เขียน\n}\n\nmsg.payload = fields;\n\nreturn msg;",
