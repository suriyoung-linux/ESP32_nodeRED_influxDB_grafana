      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 1,
      "title": "XY-MD03 Temperature",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB-ESP32}" },
      "fieldConfig": {
        "defaults": { "unit": "celsius", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB-ESP32}" },
          "query": "from(bucket: \"esp32_db\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ESP32level3_telemetry\")\n  |> filter(fn: (r) => r._field == \"xymd_temp\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ]
    },
